# Local Development Environment Variables
PORT=3000
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=itelect2_task_dev
DB_HOST=localhost

# Security & Secrets
# Generate a secret key (must be at least 32 characters) using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste_your_own_64_character_hex_string_here

# Optional: Front-end CORS origin allowed to access the API
CORS_ORIGIN=http://localhost:5173

# Render Production Environment Variables (Set on Render Dashboard)
# DATABASE_URL=your_internal_database_url_here
# JWT_SECRET=a_new_unique_64_character_hex_string
# CORS_ORIGIN=your_frontend_url_here